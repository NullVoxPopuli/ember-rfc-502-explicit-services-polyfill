{
  "name": "min-supported",
  "version": "0.0.0",
  "private": true,
  "description": "The oldest ember-source the polyfill supports",
  "repository": "",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "ember test --test-port=0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@ember/optional-features": "^2.2.0",
    "@ember/test-helpers": "^2.9.4",
    "@eslint/js": "^9.35.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "babel-loader": "^9.2.1",
    "babel-plugin-ember-polyfill-get-and-set-owner-from-ember-owner": "^1.0.0",
    "concurrently": "^9.2.1",
    "ember-auto-import": "^2.10.0",
    "ember-cli": "~4.12.3",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-dependency-checker": "^3.3.3",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-load-initializers": "^2.1.2",
    "ember-qunit": "^6.2.0",
    "ember-resolver": "^8.1.0",
    "ember-rfc-502-explicit-services-polyfill": "workspace:*",
    "ember-source": "~3.28.12",
    "ember-template-imports": "^4.3.0",
    "ember-template-lint": "^6.1.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.3",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-qunit": "^8.2.5",
    "globals": "^15.15.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-ember-template-tag": "^2.1.0",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.5.0",
    "webpack": "^5.101.3"
  },
  "engines": {
    "node": ">= 20.11"
  },
  "ember": {
    "edition": "octane"
  }
}
